# Database
DATABASE_URL=postgresql+psycopg2://recruitflow:recruitflow@db:5432/recruitflow

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Environment
ENVIRONMENT=development

# Optional: only needed if you run `pytest` against a database other than
# the default localhost:5432/recruitflow_test derived automatically.
# TEST_DATABASE_URL=postgresql+psycopg2://recruitflow:recruitflow@localhost:5432/recruitflow_test
